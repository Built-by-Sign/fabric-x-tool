{{ define "monitoring" -}}
{{- if .MonitoringPort }}
monitoring:
  endpoint: 0.0.0.0:{{ .MonitoringPort }}
  rate-limit:
    requests-per-second: 0
    burst: 0
{{- if .MonitoringTLS }}
  tls:
    key-path: {{ .MonitoringTLS.KeyPath }}
    cert-path: {{ .MonitoringTLS.CertPath }}
    mode: {{ .MonitoringTLS.Mode }}
{{- if .MonitoringTLS.CACertPaths }}
    ca-cert-paths:
{{- range .MonitoringTLS.CACertPaths }}
      - {{ . }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{ end -}}
