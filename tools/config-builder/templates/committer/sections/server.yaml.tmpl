{{ define "server" -}}
server:
  endpoint: 0.0.0.0:{{ .Port }}
  rate-limit:
    requests-per-second: 0
    burst: 0
  keep-alive:
    params:
      time: 300s
      timeout: 600s
    enforcement-policy:
      min-time: 60s
      permit-without-stream: false
  max-concurrent-streams: 0
{{- if .ServerTLS }}
  tls:
    key-path: {{ .ServerTLS.KeyPath }}
    cert-path: {{ .ServerTLS.CertPath }}
    mode: {{ .ServerTLS.Mode }}
{{- if .ServerTLS.CACertPaths }}
    ca-cert-paths:
{{- range .ServerTLS.CACertPaths }}
      - {{ . }}
{{- end }}
{{- end }}
{{- end }}
{{ end -}}
