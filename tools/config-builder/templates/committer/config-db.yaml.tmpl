# Local placeholder for the db component. The official committer role does not
# render a standalone config file for the database container.
{{ if .Database }}
database:
  type: {{ .Database.Type }}
  endpoints:
{{- range .Database.Endpoints }}
    - {{ . }}
{{- end }}
  user: {{ .Database.User }}
  password: {{ .Database.Password }}
  database: {{ .Database.DBName }}
{{- if .Database.TLS }}
  tls:
    mode: {{ .Database.TLS.Mode }}
    ca-cert-path: {{ .Database.TLS.CACertPath }}
{{- end }}
{{ end }}
