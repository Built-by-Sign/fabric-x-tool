# Derived from LF-Decentralized-Trust-labs/fabric-x-ansible-collection
# roles/committer/templates/config-sidecar.yaml.j2 (adapted to Go text/template)
# Aligned against fabric-x-committer v1.0.0.
#
# v0.2.0 schema changes vs v0.1.9:
#   - orderer.channel-id / organizations / consensus-type removed;
#     orderer endpoints + TLS material are now discovered from the
#     config block referenced by orderer.latest-known-config-block-path.
#   - bootstrap.genesis-block-file-path removed (replaced by the same path).
#   - orderer.tls.common-ca-cert-paths remains as a temporary CA fallback.
#
# Copyright IBM Corp. All Rights Reserved.
#
# SPDX-License-Identifier: Apache-2.0
#

{{ template "server" . }}
orderer:
  fault-tolerance-level: BFT
  latest-known-config-block-path: {{ .GenesisBlockPath }}
  # Note: the former `skip-block-signature-verification` escape hatch (fork
  # Built-by-Sign/fabric-x-committer, upstream PR #552) is retired. The
  # alpha-era rejections ("0 sub-policies satisfied") were caused by the
  # sidecar not detecting arma consensus and skipping the IdentifierHeader
  # BFT verification path — fixed upstream in fabric-x-committer#597,
  # included in v1.0.0. BFT verification now runs normally.
{{- if .OrdererTLS }}
  tls:
{{- if .OrdererTLS.CommonCACertPaths }}
    common-ca-cert-paths:
{{- range .OrdererTLS.CommonCACertPaths }}
      - {{ . }}
{{- end }}
{{- end }}
    key-path: {{ .OrdererTLS.KeyPath }}
    cert-path: {{ .OrdererTLS.CertPath }}
    mode: {{ .OrdererTLS.Mode }}
{{- end }}
  identity:
    msp-id: {{ .SidecarIdentityMSPID }}
    msp-dir: {{ .SidecarIdentityMSPDir }}
{{- if .SidecarIdentityBCCSP }}
    bccsp:
      Default: {{ .SidecarIdentityBCCSP.Default }}
{{- if .SidecarIdentityBCCSP.PKCS11 }}
      PKCS11:
        Library: {{ .SidecarIdentityBCCSP.PKCS11.Library }}
        Label: "{{ .SidecarIdentityBCCSP.PKCS11.Label }}"
        Pin: "{{ .SidecarIdentityBCCSP.PKCS11.Pin }}"
        Hash: {{ .SidecarIdentityBCCSP.PKCS11.Hash }}
        Security: {{ .SidecarIdentityBCCSP.PKCS11.Security }}
{{- end }}
{{- if .SidecarIdentityBCCSP.SW }}
      SW:
        Hash: {{ .SidecarIdentityBCCSP.SW.Hash }}
        Security: {{ .SidecarIdentityBCCSP.SW.Security }}
{{- end }}
{{- end }}
committer:
  endpoint: {{ .CommitterHost }}:{{ .CommitterPort }}
{{- if .CommitterTLS }}
  tls:
    ca-cert-paths:
{{- range .CommitterTLS.CACertPaths }}
      - {{ . }}
{{- end }}
    key-path: {{ .CommitterTLS.KeyPath }}
    cert-path: {{ .CommitterTLS.CertPath }}
    mode: {{ .CommitterTLS.Mode }}
{{- end }}
ledger:
  path: {{ .ConfigDir }}/ledger
last-committed-block-set-interval: 5s
{{ template "monitoring" . }}
{{ template "logging" . }}
